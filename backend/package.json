{
  "name": "samatric-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SAMATRIC backend: eligibility engine and API",
  "scripts": {
    "start": "node --env-file=../.env src/server.js",
    "dev": "node --watch --env-file=../.env src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node --env-file=../.env src/cli/check.js",
    "build:static": "node --env-file=../.env src/cli/build-static.js",
    "preview:static": "node src/cli/preview-static.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.13.0"
  }
}
